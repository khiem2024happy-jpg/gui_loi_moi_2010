const groups = [{"id": "me", "name": "Mẹ", "icon": "🌷", "desc": "Người luôn dành phần tốt nhất cho mình", "variants": [{"title": "Ấm áp như một cái ôm", "wish": "Con chúc Mẹ luôn khỏe, an vui và có nhiều ngày được làm những điều Mẹ thích. Cảm ơn Mẹ vì những chăm chút bình dị đã làm nhà mình ấm áp.", "invite": "Tối 18/10, Mẹ đi nghe nhạc cùng con ở Vịnh Hoàng Hôn nhé? Con muốn dành một buổi tối ngồi cạnh Mẹ, cùng nghe những giai điệu quen và chuyện trò thật thong thả."}, {"title": "Con ít nói, nhưng con thương", "wish": "Mẹ ơi, con không quen nói lời tình cảm. Nhưng con luôn biết ơn Mẹ và mong Mẹ có thật nhiều niềm vui, cả những niềm vui dành riêng cho mình.", "invite": "Con thấy có đêm nhạc tri ân phụ nữ ở Hạ Long vào tối 18/10. Mẹ đi cùng con nhé? Con muốn nói lời cảm ơn Mẹ bằng một cuộc hẹn, thay vì lại để dành."}, {"title": "Rủ Mẹ đi chơi một bữa", "wish": "Chúc Mẹ khỏe, vui, bớt phải nhắc con những chuyện Mẹ đã nhắc cả trăm lần. Con đang cố tiến bộ, còn tình thương dành cho Mẹ thì vẫn đầy đủ nha!", "invite": "Mẹ ơi, tối 18/10 mình đổi lịch: con rủ Mẹ đi nghe nhạc! Mẹ xem có thích không, con thu xếp chuyện đi lại. Địa điểm là Vịnh Hoàng Hôn, vẫn ở Hạ Long nhà mình thôi."}, {"title": "Đừng để lời cảm ơn chờ mãi", "wish": "Có những việc Mẹ làm con từng nghĩ là bình thường, lớn lên mới hiểu đó là yêu thương. Con chúc Mẹ có nhiều ngày nhẹ lòng và luôn có người ở bên hỏi han, sẻ chia.", "invite": "Tối 18/10, con muốn cùng Mẹ đến Dáng Hình Của Yêu Thương. Mình ngồi nghe nhạc bên vịnh, rồi con nghe Mẹ kể những điều Mẹ vẫn muốn làm nhé."}, {"title": "Một câu thôi, thật lòng", "wish": "Chúc Mẹ khỏe, vui và bình an. Con thương Mẹ, cả những ngày con quên nói.", "invite": "Tối 18/10 Mẹ đi nghe nhạc cùng con nhé? 19:30 ở Vịnh Hoàng Hôn, Hạ Long. Con muốn có một buổi tối dành cho Mẹ."}]}, {"id": "vo", "name": "Vợ", "icon": "♡", "desc": "Người cùng mình đi qua những ngày thường", "variants": [{"title": "Cảm ơn những điều nhỏ", "wish": "Chúc em luôn khỏe, vui và có thời gian cho những điều em thích. Cảm ơn em vì những quan tâm mỗi ngày, cả những điều anh đôi khi nhận ra hơi muộn.", "invite": "Tối 18/10 mình đi nghe nhạc ở Vịnh Hoàng Hôn nhé? Anh muốn có một buổi tối bên em, nghe nhạc và hỏi xem dạo này em có điều gì muốn kể."}, {"title": "Anh không giỏi nói lời hay", "wish": "Anh không biết chúc sao cho thật hay. Anh chỉ mong em được vui, được nghỉ khi mệt và biết rằng những điều em làm cho gia đình luôn đáng được trân trọng.", "invite": "Anh thấy có chương trình Dáng Hình Của Yêu Thương ở Hạ Long tối 18/10. Em đi cùng anh nhé? Anh muốn dành thời gian cho hai đứa và nói một lời cảm ơn em."}, {"title": "Hẹn hò lại với vợ mình", "wish": "Chúc vợ anh luôn vui, khỏe và có thêm những ngày không phải hỏi: “Anh nhớ chưa?”. Lần này anh nhớ được một việc quan trọng rồi: rủ em đi chơi!", "invite": "Tối 18/10, cho anh một cuộc hẹn nhé? Mình đi nghe nhạc ở Vịnh Hoàng Hôn. Có chương trình tri ân phụ nữ, và anh có một người phụ nữ rất muốn đi cùng."}, {"title": "Một tối dành riêng cho em", "wish": "Dạo này mình nói nhiều về việc phải làm, mà ít nói về điều em muốn. Anh chúc em giữ được những niềm vui của riêng mình, và mong mình biết chăm sóc nhau dịu dàng hơn.", "invite": "Tối 18/10 mình thu xếp một buổi hẹn nhé? Anh muốn cùng em nghe nhạc, để chuyện công việc sang một bên và dành sự chú ý cho người đang ngồi cạnh mình."}, {"title": "Ngắn mà đủ thương", "wish": "Chúc em vui, khỏe và được yêu thương mỗi ngày. Cảm ơn em đã cùng anh xây những điều bình dị mà quý giá.", "invite": "Em đi nghe nhạc cùng anh tối 18/10 nhé? 19:30 tại Vịnh Hoàng Hôn, Hạ Long. Một cuộc hẹn cho hai đứa mình."}]}, {"id": "chi", "name": "Chị gái", "icon": "🌸", "desc": "Người chị luôn có một chỗ cho mình", "variants": [{"title": "Có chị, thấy lòng yên", "wish": "Chúc chị luôn khỏe, an vui và có thêm thời gian cho mình. Cảm ơn chị vì những lần lắng nghe, giúp đỡ và dành cho em một chỗ để dựa vào.", "invite": "Tối 18/10 chị đi nghe nhạc cùng em nhé? Có đêm nhạc tri ân phụ nữ ở Vịnh Hoàng Hôn. Em muốn chị em mình có một buổi tối vui và gần nhau hơn."}, {"title": "Ngại nói, gửi chị vài dòng", "wish": "Em ít khi nói lời tình cảm với chị, nhưng em luôn quý những điều chị làm cho em và gia đình. Mong chị có nhiều niềm vui, bớt lo nghĩ và được quan tâm thật nhiều.", "invite": "Em gửi chị một lời rủ: tối 18/10 mình đi nghe nhạc nhé? Nếu chị thuận tiện, chị em mình cùng đến Vịnh Hoàng Hôn. Lâu rồi mình chưa có một cuộc hẹn như thế."}, {"title": "Chị đẹp, mình đi chơi thôi", "wish": "Chúc chị đẹp vui hơn chuyện hôm qua, khỏe hơn những ngày bận rộn và luôn có người rủ đi chơi đúng lúc. Hôm nay người đó là em đây!", "invite": "Tối 18/10 chị đi nghe nhạc cùng em không? Vịnh Hoàng Hôn có chương trình khá hợp để chị em mình đổi gió. Mình ngồi nghe nhạc, nói chuyện và có một tối thật vui nhé."}, {"title": "Cảm ơn người chị của em", "wish": "Có những lần chị đứng về phía em mà chẳng cần nói nhiều. Em nhớ và biết ơn những điều ấy. Chúc chị luôn có người lắng nghe mình như cách chị đã lắng nghe em.", "invite": "Tối 18/10, em muốn rủ chị đến Dáng Hình Của Yêu Thương. Một cuộc hẹn ở Hạ Long để em dành thời gian bên chị và gửi một lời cảm ơn thật lòng."}, {"title": "Một lời rủ giản dị", "wish": "Chúc chị khỏe, vui và có nhiều ngày nhẹ lòng. Cảm ơn chị vì đã luôn thương em.", "invite": "Chị đi nghe nhạc cùng em tối 18/10 nhé? 19:30 ở Vịnh Hoàng Hôn. Mình dành một tối cho nhau."}]}, {"id": "em", "name": "Em gái", "icon": "☀", "desc": "Một lời động viên cho cô gái mình thương", "variants": [{"title": "Cứ vui theo cách của em", "wish": "Chúc em khỏe, vui và tự tin với những lựa chọn của mình. Mong em có những người bạn tốt, những niềm vui nhỏ và một nơi để sẻ chia khi cần.", "invite": "Tối 18/10 em đi nghe nhạc cùng chị nhé? Có chương trình ở Vịnh Hoàng Hôn, Hạ Long. Chị muốn hai chị em có một cuộc hẹn vui, nghe nhạc và kể chuyện với nhau."}, {"title": "Không quen nói, vẫn thương", "wish": "Chị không hay nói những câu tình cảm, nhưng chị luôn mong em bình an và vui với cuộc sống mình đang xây. Khi mệt cũng cho phép mình nghỉ nhé.", "invite": "Chị thấy có đêm nhạc tri ân phụ nữ tối 18/10. Nếu em thích, mình đi cùng nhau ở Vịnh Hoàng Hôn nhé? Chị muốn dành một tối nghe em kể chuyện."}, {"title": "Cô em bận rộn, nhận lịch hẹn", "wish": "Chúc cô em của chị nhiều niềm vui, ít áp lực và luôn có pin cho những điều mình thích. Nhớ để dành một chút pin cho cuộc hẹn chị sắp rủ nha!", "invite": "Tối 18/10 mình đi nghe nhạc không? Hạ Long có nhiều chỗ vui, lần này thử Vịnh Hoàng Hôn nhé. Một tối không cần chạy lịch, chỉ cần đi cùng nhau."}, {"title": "Luôn có người để trở về", "wish": "Chúc em giữ được sự hồn nhiên và những ước muốn riêng. Dù có ngày mọi chuyện chưa như ý, mong em vẫn nhớ mình có người thân để tìm về và kể hết.", "invite": "Tối 18/10, mình cùng đi nghe Dáng Hình Của Yêu Thương nhé? Chị muốn có thêm một kỷ niệm đẹp với em, ngay ở Hạ Long thành phố mình."}, {"title": "Nhẹ nhàng và gần gũi", "wish": "Chúc em khỏe, vui và luôn có người để sẻ chia. Thương em nhiều.", "invite": "Tối 18/10 đi nghe nhạc cùng chị nhé? 19:30 ở Vịnh Hoàng Hôn. Em xem lịch rồi báo chị nha."}]}, {"id": "dongnghiep", "name": "Đồng nghiệp", "icon": "✧", "desc": "Lịch sự, gần gũi và vừa đủ", "variants": [{"title": "Ghi nhận sự đồng hành", "wish": "Chúc bạn khỏe, vui và công việc thuận lợi. Cảm ơn những lần bạn đã hỗ trợ, chia sẻ và cùng mọi người thu xếp những việc khó.", "invite": "Mình gửi bạn một gợi ý cho tối 18/10: Dáng Hình Của Yêu Thương tại Vịnh Hoàng Hôn, Hạ Long. Nếu bạn thích nghe nhạc và thuận tiện, mình cùng đi nhé."}, {"title": "Lời rủ không làm phiền", "wish": "Chúc bạn luôn có những ngày làm việc hiệu quả và những khoảng nghỉ thật dễ chịu. Cảm ơn vì sự hỗ trợ của bạn trong thời gian qua.", "invite": "Mình thấy có đêm nhạc tri ân phụ nữ ở Hạ Long tối 18/10 nên gửi bạn tham khảo. Nếu hợp sở thích và lịch của bạn, mình cùng đi; bạn cứ xem rồi báo mình nhé."}, {"title": "Tan ca, đổi không khí", "wish": "Chúc bạn ít deadline bất ngờ, nhiều ngày làm việc suôn sẻ và có thời gian cho niềm vui ngoài giờ. Cảm ơn người đồng đội đã cùng mình vượt bao danh sách việc!", "invite": "Tối 18/10 mình đổi không khí ở Vịnh Hoàng Hôn nhé? Có chương trình âm nhạc tri ân phụ nữ. Nếu thuận tiện, rủ thêm vài người cùng đi nghe nhạc cũng vui."}, {"title": "Một lời cảm ơn đúng mực", "wish": "Có những việc sẽ khó hơn nhiều nếu thiếu sự hỗ trợ của bạn. Mình trân trọng điều đó. Chúc bạn khỏe, vui và những cố gắng luôn được ghi nhận.", "invite": "Nếu bạn muốn dành một tối thư giãn ở Hạ Long, mình xin gợi ý đêm nhạc Dáng Hình Của Yêu Thương ngày 18/10. Bạn có thể rủ người thân đi cùng, hoặc mình hẹn nhau tại chương trình."}, {"title": "Gọn và lịch sự", "wish": "Chúc bạn khỏe, vui, công việc thuận lợi. Cảm ơn bạn đã luôn hỗ trợ mọi người.", "invite": "Bạn có muốn đi nghe nhạc tối 18/10 không? Chương trình lúc 19:30 tại Vịnh Hoàng Hôn, Hạ Long. Bạn xem lịch rồi báo mình nhé."}]}, {"id": "sep", "name": "Sếp nữ", "icon": "🌿", "desc": "Trân trọng, tinh tế, không tâng bốc", "variants": [{"title": "Trân trọng và ấm áp", "wish": "Em chúc chị luôn khỏe, an vui và có những khoảng nghỉ thật thoải mái bên gia đình. Cảm ơn chị đã hướng dẫn và dành sự quan tâm cho công việc của mọi người.", "invite": "Em xin gửi chị lời mời tham dự Dáng Hình Của Yêu Thương, tối 18/10 tại Vịnh Hoàng Hôn, Hạ Long. Nếu chị thuận tiện, rất mong được cùng chị và người thân thưởng thức đêm nhạc."}, {"title": "Mở lời nhẹ nhàng", "wish": "Em chúc chị sức khỏe, công việc thuận lợi và có thời gian cho những điều chị yêu thích. Em trân trọng những chia sẻ và hướng dẫn của chị.", "invite": "Em có một gợi ý về đêm nhạc tri ân phụ nữ ở Hạ Long, xin gửi chị tham khảo. Chương trình diễn ra tối 18/10 tại Vịnh Hoàng Hôn. Chị xem lịch, nếu phù hợp thì mình cùng tham dự ạ."}, {"title": "Sau những ngày bận rộn", "wish": "Chúc chị có thêm những buổi tối thảnh thơi sau những ngày nhiều việc. Mong bên cạnh công việc, chị vẫn giữ được thời gian cho gia đình và những niềm vui riêng.", "invite": "Tối 18/10 có đêm nhạc Dáng Hình Của Yêu Thương tại Vịnh Hoàng Hôn. Em xin phép mời chị cùng đến nghe nhạc nếu thuận tiện; chị có thể đi cùng người thân ạ."}, {"title": "Cảm ơn sự dẫn dắt", "wish": "Cảm ơn chị vì những lần hướng dẫn em nhìn vấn đề rõ hơn và làm việc tốt hơn. Em chúc chị khỏe, bình an và những nỗ lực có thêm nhiều kết quả tốt đẹp.", "invite": "Em xin mời chị đến một đêm nhạc dành cho lòng biết ơn và sự gắn kết: Dáng Hình Của Yêu Thương, tối 18/10 ở Hạ Long. Nếu chị sắp xếp được, rất mong có dịp cùng chị tham dự."}, {"title": "Ngắn gọn, trang trọng", "wish": "Em chúc chị khỏe, vui và công việc thuận lợi. Cảm ơn chị đã luôn hướng dẫn và hỗ trợ em.", "invite": "Em kính mời chị tham dự đêm nhạc lúc 19:30 ngày 18/10 tại Vịnh Hoàng Hôn, Hạ Long. Chị xem lịch và báo lại em nếu thuận tiện ạ."}]}, {"id": "ban-gai", "name": "Bạn gái", "icon": "💌", "desc": "Một lời thương và một cuộc hẹn", "variants": [{"title": "Một cuộc hẹn dịu dàng", "wish": "Chúc em luôn khỏe, vui và có thật nhiều điều để mong chờ. Anh thích những lúc em kể chuyện của mình và mong luôn có thời gian để lắng nghe em.", "invite": "Tối 18/10, em đi nghe nhạc cùng anh ở Vịnh Hoàng Hôn nhé? Anh muốn cùng em có một cuộc hẹn thật ấm, ngay giữa Hạ Long mình đang sống."}, {"title": "Ngại nói, nhưng muốn mời", "wish": "Anh không giỏi viết lời chúc, nhưng anh thật lòng mong em vui và được quan tâm. Anh cũng muốn mình dành cho nhau nhiều thời gian hơn.", "invite": "Anh thấy có đêm nhạc Dáng Hình Của Yêu Thương tối 18/10. Em có muốn đi cùng anh không? Nếu em thuận tiện, mình hẹn ở Vịnh Hoàng Hôn nhé."}, {"title": "Một lịch hẹn xin được duyệt", "wish": "Chúc em nhiều niềm vui, ít chuyện phải nghĩ ngợi và luôn có người rủ đi chơi đúng sở thích. Anh đang nộp đơn ứng tuyển người đó đây!", "invite": "Đơn xin một cuộc hẹn: tối 18/10, nghe nhạc tại Vịnh Hoàng Hôn. Người đi cùng: anh. Em xem lịch rồi duyệt nếu thấy hợp nhé."}, {"title": "Muốn giữ thêm một kỷ niệm", "wish": "Chúc em giữ được những điều mình yêu thích và có người cùng sẻ chia cả ngày vui lẫn ngày mệt. Anh trân trọng những khoảng thời gian được ở bên em.", "invite": "Hạ Long có nhiều nơi đẹp, anh muốn thêm một nơi vào những kỷ niệm của hai đứa. Tối 18/10 em đi nghe Dáng Hình Của Yêu Thương cùng anh nhé?"}, {"title": "Một câu thương, một lời hẹn", "wish": "Chúc em khỏe, vui và có những ngày thật dịu dàng. Anh thương em.", "invite": "Tối 18/10, đi nghe nhạc cùng anh nhé? 19:30 tại Vịnh Hoàng Hôn, Hạ Long. Anh muốn dành một tối bên em."}]}, {"id": "ban-than", "name": "Bạn thân", "icon": "✨", "desc": "Rủ người cùng mình chia sẻ bao chuyện", "variants": [{"title": "Cảm ơn vì luôn lắng nghe", "wish": "Chúc cậu khỏe, vui và có nhiều ngày nhẹ lòng. Cảm ơn vì những lần đã ngồi nghe tớ kể đủ thứ chuyện, cả những chuyện tớ kể đi kể lại.", "invite": "Tối 18/10 mình đi nghe nhạc nhé? Có chương trình ở Vịnh Hoàng Hôn. Tớ muốn cùng cậu có một buổi tối vui và thêm chuyện để nhắc lại sau này."}, {"title": "Không sến, vẫn quý nhau", "wish": "Tớ ít gửi lời chúc dài, nhưng thật lòng mong cậu vui với những điều mình đang làm. Khi mệt nhớ tìm người kể chuyện, tớ vẫn nghe được nhé.", "invite": "Tớ thấy có đêm nhạc ở Hạ Long tối 18/10, nghĩ có thể cậu thích. Nếu rảnh, mình cùng đi Vịnh Hoàng Hôn nhé. Cậu xem lịch rồi báo tớ."}, {"title": "Rủ hội bạn đổi gió", "wish": "Chúc cậu bớt bận, bớt nghĩ nhiều và có thêm những cuộc hẹn thật vui. Hôm nay tớ chủ động kéo cậu ra khỏi danh sách “hẹn khi nào rảnh” đây!", "invite": "Tối 18/10 đi nghe nhạc với tớ không? Vịnh Hoàng Hôn có chương trình tri ân phụ nữ. Mình rủ thêm bạn nếu hợp lịch, rồi dành một tối vui ở Hạ Long nhé."}, {"title": "Thương tình bạn lâu dài", "wish": "Chúc cậu luôn có người đồng hành và một nơi được là chính mình. Tớ biết ơn vì qua nhiều thay đổi, mình vẫn có thể tìm nhau và nói chuyện thật lòng.", "invite": "Tối 18/10 mình cùng đến Dáng Hình Của Yêu Thương nhé? Một cuộc hẹn nghe nhạc, ngắm không gian bên vịnh và dành thời gian cho tình bạn của mình."}, {"title": "Gửi nhanh cho người thân quen", "wish": "Chúc cậu khỏe, vui và mọi chuyện dần thuận lợi. Có gì cứ kể tớ nghe nhé.", "invite": "Tối 18/10 đi nghe nhạc cùng tớ không? 19:30 tại Vịnh Hoàng Hôn, Hạ Long. Mình hẹn một buổi nhé!"}]}];