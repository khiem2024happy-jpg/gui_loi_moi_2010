let groupIndex=0,variantIndex=0,mode='both',saved=[],toastTimer;try{saved=JSON.parse(localStorage.getItem('cx-wish-saved')||'[]');if(!Array.isArray(saved))saved=[]}catch{}const $=id=>document.getElementById(id);const styleNames=['Ấm áp','Ngại mở lời','Nhẹ nhàng','Thật sâu','Gửi nhanh'];const current=()=>groups[groupIndex].variants[variantIndex];
function announce(t){$('toast').textContent=t;$('toast').hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').hidden=true,4500)}
function buildText(){const v=current();const name=$('personName').value.trim();return (name?'Thương gửi '+name+',\n\n':'')+(mode==='wish'?v.wish:mode==='invite'?v.invite:v.wish+'\n\n'+v.invite)}
function fill(){ $('message').value=buildText();$('chosenTitle').textContent=current().title;document.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',b.classList.contains('active')));updateSave(); }
function updateSave(){const id=groupIndex+':'+variantIndex;$('save').textContent=saved.includes(id)?'♥ Đã lưu mẫu này':'♡ Lưu mẫu này';$('save').setAttribute('aria-pressed',String(saved.includes(id)));$('savedCount').textContent=saved.length;}
function render(){document.querySelectorAll('.recipient').forEach((b,i)=>{b.classList.toggle('active',i===groupIndex);b.setAttribute('aria-pressed',String(i===groupIndex))});$('groupTitle').textContent='5 cách gửi '+groups[groupIndex].name;$('groupDesc').textContent=groups[groupIndex].desc;$('variants').replaceChildren();groups[groupIndex].variants.forEach((v,i)=>{const b=document.createElement('button');b.className='variant'+(i===variantIndex?' active':'');b.setAttribute('aria-pressed',String(i===variantIndex));const n=document.createElement('small');n.textContent='0'+(i+1)+' / '+styleNames[i];const title=document.createElement('strong');title.textContent=v.title;const sub=document.createElement('p');sub.textContent=i===variantIndex?'Đang chọn · chỉnh ở bên dưới':'Chạm để chọn lời của bạn';b.append(n,title,sub);b.onclick=()=>{variantIndex=i;render();b.focus()};$('variants').append(b)});fill();personalize();}
function personalize(){const name=groups[groupIndex].name;const titles={me:'Gửi lời cho Mẹ rồi. Mình ngồi nghe nhạc cùng Mẹ nhé?',vo:'Một lời thương. Thêm một buổi hẹn với Vợ.',chi:'Một cuộc hẹn cho chị em mình.',em:'Rủ em đi nghe nhạc, cùng giữ một kỷ niệm.',dongnghiep:'Một tối đổi không khí cùng đồng nghiệp.',sep:'Một gợi ý trang trọng dành cho người chị mình quý.','ban-gai':'Để lời thương có thêm một cuộc hẹn.','ban-than':'Rủ người bạn quý cùng đi nghe nhạc.'};$('bridgeTitle').textContent=titles[groups[groupIndex].id];$('bridgeText').textContent='Cảm Xúc Club xin gợi ý Dáng Hình Của Yêu Thương — tối 18/10 tại Vịnh Hoàng Hôn. Một đêm nhạc tri ân những người phụ nữ, ngay ở Hạ Long.';$('programPersonal').textContent=name==='Đồng nghiệp'?'Nếu muốn có một buổi tối thư giãn cùng những đồng nghiệp quý mến ở Hạ Long, đây là một gợi ý để cùng nghe nhạc và chia sẻ niềm vui.':name==='Sếp nữ'?'Một lời mời trang trọng tới đêm nhạc tri ân phụ nữ ở Hạ Long — dành cho người chị mình quý và người thân.':'Hạ Long có nhiều nơi để vui. Lần này, hãy thử dành một buổi tối cùng '+name.toLowerCase()+' — để lời thương được tiếp nối bằng thời gian bên nhau.';}
groups.forEach((g,i)=>{const b=document.createElement('button');b.className='recipient';const icon=document.createElement('span');icon.className='icon';icon.textContent=g.icon;icon.setAttribute('aria-hidden','true');const name=document.createElement('strong');name.textContent=g.name;b.append(icon,name);b.onclick=()=>{groupIndex=i;variantIndex=0;$('personName').value='';render();$('variants').scrollLeft=0};$('recipients').append(b)});
document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode;document.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('active',x===b));fill()});$('personName').addEventListener('input',fill);$('reset').onclick=()=>{fill();announce('Đã trở lại lời gốc. Bạn có thể sửa theo cách mình nói.')};$('surprise').onclick=()=>{variantIndex=(variantIndex+1+Math.floor(Math.random()*4))%5;render();document.querySelector('.variant.active').scrollIntoView({block:'nearest',inline:'center',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})};
function afterAction(){ $('bridge').hidden=false;const burst=document.createElement('div');burst.className='heart-burst';burst.setAttribute('aria-hidden','true');for(let i=0;i<6;i++){const s=document.createElement('span');s.textContent='♡';s.style.setProperty('--shift',(i-2.5)*35+'px');s.style.animationDelay=i*.05+'s';burst.append(s)}document.body.append(burst);setTimeout(()=>burst.remove(),1700)}
async function copy(){const text=$('message').value.trim();if(!text){announce('Hãy viết một lời trước khi sao chép nhé.');$('message').focus();return}try{await navigator.clipboard.writeText(text);announce('Đã sao chép ♡ Dán vào Zalo, Messenger hoặc tin nhắn để gửi.');afterAction()}catch{$('message').focus();$('message').select();announce('Đã chọn nội dung. Bạn có thể sao chép từ ô lời thương.')}}$('copy').onclick=copy;$('mobileCopy').onclick=copy;
$('share').onclick=async()=>{const text=$('message').value.trim();if(!text){announce('Hãy viết một lời trước khi gửi nhé.');return}if(!navigator.share){await copy();return}try{await navigator.share({title:'Một lời thương dành cho bạn',text});afterAction();announce('Lời thương đã sẵn sàng trong ứng dụng chia sẻ của bạn.')}catch(e){if(e.name!=='AbortError')announce('Bạn có thể dùng nút Sao chép để gửi lời thương.')}};
$('save').onclick=()=>{const id=groupIndex+':'+variantIndex;if(saved.includes(id))saved=saved.filter(x=>x!==id);else saved.push(id);try{localStorage.setItem('cx-wish-saved',JSON.stringify(saved));announce(saved.includes(id)?'Đã giữ lại mẫu này trên thiết bị của bạn.':'Đã bỏ mẫu khỏi danh sách lưu.')}catch{announce('Mẫu được giữ trong phiên này; trình duyệt chưa cho phép lưu lâu dài.')}updateSave()};
$('showSaved').onclick=()=>{$('savedList').replaceChildren();let n=0;saved.forEach(id=>{const [g,v]=String(id).split(':').map(Number);if(!groups[g]?.variants[v])return;n++;const b=document.createElement('button');b.className='saved-item';b.textContent=groups[g].variants[v].title;const small=document.createElement('small');small.textContent='Gửi '+groups[g].name+' · '+styleNames[v];b.append(small);b.onclick=()=>{groupIndex=g;variantIndex=v;$('personName').value='';render();$('savedDialog').close();$('editor').scrollIntoView({behavior:'smooth'})};$('savedList').append(b)});if(!n){const p=document.createElement('p');p.textContent='Chưa có mẫu được lưu. Chạm ♡ Lưu mẫu này khi bạn tìm thấy lời mình thích.';$('savedList').append(p)}$('savedDialog').showModal()};$('closeSaved').onclick=()=>$('savedDialog').close();
$('card').onclick=async()=>{const text=$('message').value.trim();if(!text){announce('Hãy chọn hoặc viết lời thương trước nhé.');return}const button=$('card');button.disabled=true;try{await document.fonts.ready;const canvas=document.createElement('canvas');const ctx=canvas.getContext('2d');const width=1080,margin=95,lineHeight=51;canvas.width=width;ctx.font='30px "Be Vietnam Pro"';const wrapped=[];text.split('\n').forEach(paragraph=>{if(!paragraph.trim()){wrapped.push('');return}let line='';paragraph.split(/\s+/).forEach(word=>{let next=line?line+' '+word:word;if(ctx.measureText(next).width>width-margin*2&&line){wrapped.push(line);line=word}else line=next});if(line)wrapped.push(line)});canvas.height=Math.max(1200,420+wrapped.length*lineHeight);ctx.fillStyle='#fbf3e9';ctx.fillRect(0,0,width,canvas.height);const grad=ctx.createLinearGradient(0,0,width,canvas.height);grad.addColorStop(0,'#f4dfe6');grad.addColorStop(1,'#f2e4cb');ctx.fillStyle=grad;ctx.fillRect(25,25,width-50,canvas.height-50);ctx.strokeStyle='#c79f78';ctx.lineWidth=2;ctx.strokeRect(55,55,width-110,canvas.height-110);ctx.textAlign='center';ctx.fillStyle='#9a5670';ctx.font='88px "Great Vibes"';ctx.fillText('Một lời thương',width/2,160);ctx.fillStyle='#8f777b';ctx.font='19px "Be Vietnam Pro"';ctx.fillText('GỬI TỪ HẠ LONG',width/2,210);ctx.textAlign='left';ctx.fillStyle='#493038';ctx.font='30px "Be Vietnam Pro"';wrapped.forEach((line,i)=>ctx.fillText(line,margin,310+i*lineHeight));ctx.textAlign='center';ctx.font='19px "Be Vietnam Pro"';ctx.fillStyle='#a18086';ctx.fillText('Cảm Xúc Club · Để âm nhạc nối những yêu thương',width/2,canvas.height-95);canvas.toBlob(blob=>{if(!blob){announce('Chưa tạo được thiệp. Xin thử lại.');return}const u=URL.createObjectURL(blob);const a=document.createElement('a');a.href=u;a.download='mot-loi-thuong-ha-long.png';a.click();setTimeout(()=>URL.revokeObjectURL(u),2000);announce('Đã tải thiệp. Bạn có thể gửi ảnh cho người thương.');afterAction()},'image/png')}catch{announce('Chưa tạo được thiệp. Bạn vẫn có thể sao chép lời thương.')}finally{button.disabled=false}};
if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const targets=document.querySelectorAll('.hero,.section-title,.program .wrap,.ending');targets.forEach(x=>x.classList.add('reveal'));const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('seen');observer.unobserve(e.target)}}),{threshold:.08});targets.forEach(x=>observer.observe(x));document.documentElement.classList.add('motion-ready')}render();
